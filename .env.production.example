# ─────────────────────────────────────────────────────────────
# Variáveis de PRODUÇÃO (Coolify) — usadas por docker-compose.yml
# No Coolify, defina estas em: Resource → Environment Variables.
# Os itens marcados (obrigatório) NÃO têm default — o deploy falha sem eles.
#
# Domínios (atribuir na UI do Coolify, por serviço):
#   web (porta 80)   -> https://musicasys-joaoof.com.br
#   api (porta 8080) -> https://apimusicasys-joaoof.com.br
# ─────────────────────────────────────────────────────────────

# ── Postgres ──────────────────────────────
POSTGRES_USER=portal
POSTGRES_PASSWORD=                      # (obrigatório) senha forte
POSTGRES_DB=portal_aluno

# ── API (.NET 10) ─────────────────────────
JWT_KEY=                                # (obrigatório) segredo >= 32 caracteres
ADMIN_NAME=Professor
ADMIN_EMAIL=admin@seudominio.com
ADMIN_PASSWORD=                         # (obrigatório) senha do super usuário (seed)

# URL pública do front — usada no CORS da API (caso o front chame a API
# direto pelo domínio dela). Com o proxy /api do Caddy (mesma origem) o app
# nem precisa, mas mantenha alinhado ao domínio público do front.
WEB_PUBLIC_URL=https://musicasys-joaoof.com.br
