# ─────────────────────────────────────────────────────────────
# Variáveis de PRODUÇÃO (Coolify) — usadas por docker-compose.prod.yml
# No Coolify, defina estas em: Resource → Environment Variables.
# Os itens marcados (obrigatório) NÃO têm default — o deploy falha sem eles.
# ─────────────────────────────────────────────────────────────

# ── Postgres ──────────────────────────────
POSTGRES_USER=portal
POSTGRES_PASSWORD=                      # (obrigatório) senha forte
POSTGRES_DB=portal_aluno

# ── API (.NET 10) ─────────────────────────
JWT_KEY=                                # (obrigatório) segredo >= 32 caracteres
ADMIN_NAME=Professor
ADMIN_EMAIL=admin@seudominio.com
ADMIN_PASSWORD=                         # (obrigatório) senha do super usuário (seed)

# URL pública do front (opcional) — usada só para CORS de acesso direto à API.
# Com o proxy /api do nginx (mesma origem), normalmente não é necessária.
WEB_PUBLIC_URL=https://seudominio.com
